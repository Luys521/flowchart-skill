{
  "comment": "equiv 的用例清单：覆盖本包的公开命令面。用法见 tools/equiv-README.md。占位符 {side}=代码根（跑 scripts/xxx.py）、{work}=数据区（产物与 fixture 落在这里，绝不写进仓库）、{root}/{base}/{py} 由 tools/equiv.py 替换；路径用正斜杠。",
  "copy": ["scripts", "templates"],
  "setup": [
    {"kind": "copy", "name": "铺正常表", "src": "{root}/dev/tools/equiv-fixtures/tour.md",
     "dst": "{work}/out/tour/flowtable.md"},
    {"kind": "copy", "name": "铺泳道表", "src": "{root}/dev/tools/equiv-fixtures/lane.md",
     "dst": "{work}/out/lane/flowtable.md"},
    {"kind": "copy", "name": "铺坏表", "src": "{root}/dev/tools/equiv-fixtures/broken.md",
     "dst": "{work}/out/broken/flowtable.md"},
    {"kind": "copy", "name": "铺 sync/apply 场景的表", "src": "{root}/dev/tools/equiv-fixtures/tour.md",
     "dst": "{work}/out/syncflow/flowtable.md"}
  ],
  "cases": [
    {"kind": "cli", "name": "init 成功", "cwd": "{side}",
     "argv": ["{py}", "{side}/scripts/init.py", "demo", "-d", "{work}/out"]},
    {"kind": "cli", "name": "init 同名冲突（应退 1）", "cwd": "{side}",
     "argv": ["{py}", "{side}/scripts/init.py", "demo", "-d", "{work}/out"]},
    {"kind": "tree", "name": "init 产物（模板两件）", "dirs": ["{work}/out/demo"]},

    {"kind": "cli", "name": "table_to_dsl --check 正常表",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--check", "{work}/out/tour/flowtable.md"]},
    {"kind": "cli", "name": "table_to_dsl --check 泳道表",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--check", "{work}/out/lane/flowtable.md"]},
    {"kind": "cli", "name": "table_to_dsl --check 坏表（H1–H9 文案）",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--check", "{work}/out/broken/flowtable.md"]},
    {"kind": "cli", "name": "table_to_dsl --check --json 坏表",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--check", "--json", "{work}/out/broken/flowtable.md"]},
    {"kind": "cli", "name": "table_to_dsl --quality showcase 坏表（软提示也阻断）",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--check", "--quality", "showcase",
              "{work}/out/broken/flowtable.md"]},
    {"kind": "cli", "name": "table_to_dsl --quality showcase 正常表（零提示放行）",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--check", "--quality", "showcase",
              "{work}/out/tour/flowtable.md"]},
    {"kind": "cli", "name": "table_to_dsl --write -o 指定输出",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--write", "-o", "{work}/out/tour/tour-flow.yaml",
              "{work}/out/tour/flowtable.md"]},
    {"kind": "files", "name": "table_to_dsl 产物（yaml + manifest）",
     "paths": ["{work}/out/tour/tour-flow.yaml", "{work}/out/tour/tour-flow.manifest.json"]},
    {"kind": "cli", "name": "table_to_dsl --write --layout 复用已有几何",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--write", "--layout",
              "{work}/out/tour/tour-flow.yaml", "{work}/out/tour/flowtable.md",
              "-o", "{work}/out/tour/tour-relayout.yaml"]},
    {"kind": "files", "name": "复用几何后的产物",
     "paths": ["{work}/out/tour/tour-relayout.yaml"]},
    {"kind": "cli", "name": "table_to_dsl --write 泳道表（默认产物名 = 目录名）",
     "argv": ["{py}", "{side}/scripts/table_to_dsl.py", "--write", "{work}/out/lane/flowtable.md"]},
    {"kind": "files", "name": "泳道 DSL 产物",
     "paths": ["{work}/out/lane/lane-flow.yaml"]},

    {"kind": "cli", "name": "build 默认（首跑：产 HTML + drawio + yaml + manifest + index）",
     "argv": ["{py}", "{side}/scripts/build.py", "{work}/out/tour/flowtable.md"]},
    {"kind": "cli", "name": "build 二次（复用已有几何的那条分支）",
     "argv": ["{py}", "{side}/scripts/build.py", "{work}/out/tour/flowtable.md"]},
    {"kind": "cli", "name": "build 泳道表",
     "argv": ["{py}", "{side}/scripts/build.py", "{work}/out/lane/flowtable.md"]},
    {"kind": "tree", "name": "build 全产物整树（流程表目录）", "dirs": ["{work}/out/tour"]},
    {"kind": "tree", "name": "build 全产物整树（泳道目录）", "dirs": ["{work}/out/lane"]},

    {"kind": "cli", "name": "validate flow.yaml（八项门禁）",
     "argv": ["{py}", "{side}/scripts/validate.py", "{work}/out/tour/tour-flow.yaml"]},
    {"kind": "cli", "name": "validate flow.yaml --json",
     "argv": ["{py}", "{side}/scripts/validate.py", "--json", "{work}/out/tour/tour-flow.yaml"]},
    {"kind": "cli", "name": "validate drawio 产物复核",
     "argv": ["{py}", "{side}/scripts/validate.py", "{work}/out/tour/tour-flow.drawio", "--artifact"]},
    {"kind": "cli", "name": "validate html 产物复核",
     "argv": ["{py}", "{side}/scripts/validate.py", "{work}/out/tour/tour-flow.html", "--artifact"]},
    {"kind": "cli", "name": "validate --artifact --dump 几何表",
     "argv": ["{py}", "{side}/scripts/validate.py", "{work}/out/tour/tour-flow.drawio", "--artifact",
              "--dump", "{work}/out/geom.json"]},
    {"kind": "files", "name": "--dump 出的几何表", "paths": ["{work}/out/geom.json"]},

    {"kind": "cli", "name": "manifest check（反查产物）",
     "argv": ["{py}", "{side}/scripts/manifest.py", "check",
              "{work}/out/tour/tour-flow.manifest.json",
              "--html", "{work}/out/tour/tour-flow.html",
              "--drawio", "{work}/out/tour/tour-flow.drawio",
              "--yaml", "{work}/out/tour/tour-flow.yaml"]},
    {"kind": "cli", "name": "manifest build（单独产契约）",
     "argv": ["{py}", "{side}/scripts/manifest.py", "build", "{work}/out/tour/tour-flow.yaml",
              "-o", "{work}/out/mf.json"]},
    {"kind": "files", "name": "单独产出的契约", "paths": ["{work}/out/mf.json"]},

    {"kind": "cli", "name": "render_html 直出",
     "argv": ["{py}", "{side}/scripts/render_html.py", "{work}/out/tour/tour-flow.yaml",
              "-o", "{work}/out/direct.html"]},
    {"kind": "files", "name": "直出 html", "paths": ["{work}/out/direct.html"]},
    {"kind": "cli", "name": "render_drawio 直出",
     "argv": ["{py}", "{side}/scripts/render_drawio.py", "{work}/out/tour/tour-flow.yaml",
              "-o", "{work}/out/direct.drawio"]},
    {"kind": "cli", "name": "render_drawio --pages",
     "argv": ["{py}", "{side}/scripts/render_drawio.py", "{work}/out/tour/tour-flow.yaml",
              "--pages", "-o", "{work}/out/direct-pages.drawio"]},
    {"kind": "files", "name": "直出 drawio（含 --pages 版）",
     "paths": ["{work}/out/direct.drawio", "{work}/out/direct-pages.drawio"]},

    {"kind": "cli", "name": "xml_reader 默认回读",
     "argv": ["{py}", "{side}/scripts/xml_reader.py", "{work}/out/tour/tour-flow.drawio"]},
    {"kind": "cli", "name": "xml_reader --json",
     "argv": ["{py}", "{side}/scripts/xml_reader.py", "{work}/out/tour/tour-flow.drawio", "--json"]},
    {"kind": "cli", "name": "xml_reader --grid",
     "argv": ["{py}", "{side}/scripts/xml_reader.py", "{work}/out/tour/tour-flow.drawio", "--grid"]},
    {"kind": "cli", "name": "xml_reader --diff",
     "argv": ["{py}", "{side}/scripts/xml_reader.py", "{work}/out/tour/tour-flow.drawio",
              "--diff", "{work}/out/tour/flowtable.md"]},

    {"kind": "cli", "name": "clarify 默认",
     "argv": ["{py}", "{side}/scripts/clarify.py", "{work}/out/tour/flowtable.md"]},
    {"kind": "cli", "name": "clarify --json",
     "argv": ["{py}", "{side}/scripts/clarify.py", "{work}/out/tour/flowtable.md", "--json"]},

    {"kind": "cli", "name": "layer_index 只算不写",
     "argv": ["{py}", "{side}/scripts/layer_index.py", "{work}/out/tour/flowtable.md"]},
    {"kind": "cli", "name": "layer_index --write",
     "argv": ["{py}", "{side}/scripts/layer_index.py", "{work}/out/tour/flowtable.md", "--write"]},
    {"kind": "files", "name": "层级索引产物",
     "paths": ["{work}/out/tour/tour-index.md"]},

    {"kind": "cli", "name": "sync 预览（不改原表）",
     "argv": ["{py}", "{side}/scripts/sync.py", "{work}/out/tour/tour-flow.drawio",
              "{work}/out/tour/flowtable.md", "-o", "{work}/out/tour/synced.md"]},
    {"kind": "cli", "name": "sync --brief",
     "argv": ["{py}", "{side}/scripts/sync.py", "{work}/out/tour/tour-flow.drawio",
              "{work}/out/tour/flowtable.md", "-o", "{work}/out/tour/synced-brief.md", "--brief"]},
    {"kind": "cli", "name": "sync --no-diff",
     "argv": ["{py}", "{side}/scripts/sync.py", "{work}/out/tour/tour-flow.drawio",
              "{work}/out/tour/flowtable.md", "-o", "{work}/out/tour/synced-nodiff.md", "--no-diff"]},
    {"kind": "files", "name": "sync 预览产物",
     "paths": ["{work}/out/tour/synced.md", "{work}/out/tour/synced-brief.md",
               "{work}/out/tour/synced-nodiff.md"]},

    {"kind": "cli", "name": "syncflow：先 build 出图（图里 02 是「是→03 ｜ 否→03b」）",
     "argv": ["{py}", "{side}/scripts/build.py", "{work}/out/syncflow/flowtable.md"]},
    {"kind": "copy", "name": "换成与图冲突的那版表（02 的两条分支对调）",
     "src": "{root}/dev/tools/equiv-fixtures/tour-rewired.md",
     "dst": "{work}/out/syncflow/flowtable.md"},
    {"kind": "files", "name": "换表后原表快照（记下 sha，供「被拦后」对照）",
     "paths": ["{work}/out/syncflow/flowtable.md"]},
    {"kind": "cli", "name": "sync 预览：报「02 分支走向与图不一致」",
     "argv": ["{py}", "{side}/scripts/sync.py", "{work}/out/syncflow/syncflow-flow.drawio",
              "{work}/out/syncflow/flowtable.md", "-o", "{work}/out/syncflow/applied.md"]},
    {"kind": "cli", "name": "sync --apply 冲突被拦（退出码应为 1，stdout 含「覆盖被拦截」；只看两侧一致）",
     "argv": ["{py}", "{side}/scripts/sync.py", "{work}/out/syncflow/syncflow-flow.drawio",
              "{work}/out/syncflow/flowtable.md", "--apply"]},
    {"kind": "files", "name": "被拦后原表快照（sha 应与「换表后」那条逐字节一致）",
     "paths": ["{work}/out/syncflow/flowtable.md"]},
    {"kind": "cli", "name": "sync --apply --force 放行（以图为准）",
     "argv": ["{py}", "{side}/scripts/sync.py", "{work}/out/syncflow/syncflow-flow.drawio",
              "{work}/out/syncflow/flowtable.md", "--apply", "--force"]},
    {"kind": "files", "name": "force 后原表快照（sha 应已变成图推导出的那版）",
     "paths": ["{work}/out/syncflow/flowtable.md"]},
    {"kind": "tree", "name": "syncflow 整树", "dirs": ["{work}/out/syncflow"]},

    {"kind": "cli", "name": "build --no-pages（drawio 只主图）",
     "argv": ["{py}", "{side}/scripts/build.py", "{work}/out/tour/flowtable.md", "--no-pages"]},
    {"kind": "cli", "name": "build --no-layout（按表序重排，丢弃并排信息）",
     "argv": ["{py}", "{side}/scripts/build.py", "{work}/out/lane/flowtable.md", "--no-layout"]},

    {"kind": "tree", "name": "整棵 out 目录一次比全（含 init/build/validate/render/sync 全部产物）",
     "dirs": ["{work}/out"]}
  ]
}
